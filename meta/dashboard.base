filters:
  or:
    - file.inFolder("concepts")
    - file.inFolder("entities")
    - file.inFolder("sources")
    - file.inFolder("questions")
    - file.inFolder("comparisons")
    - file.inFolder("domains")
    - file.inFolder("analysis")
    - file.inFolder("synthesis")
    - file.inFolder("projects")
    - file.inFolder("skills")
    - file.inFolder("strategies")
    - file.inFolder("references")
    - file.inFolder("journal")
formulas:
  days_since_edit: (now() - file.mtime).days
properties:
  file.name:
    displayName: Page
  note.type:
    displayName: Type
  note.status:
    displayName: Status
  note.tags:
    displayName: Tags
  note.updated:
    displayName: Updated
  formula.days_since_edit:
    displayName: Days Since Edit
views:
  - type: table
    name: 全部内容 · 按类型
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - status
      - updated
      - formula.days_since_edit
    sort:
      - property: formula.days_since_edit
        direction: ASC
  - type: table
    name: 全部内容 · 按状态
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - updated
      - formula.days_since_edit
  - type: table
    name: 近期更新 Top 50
    order:
      - file.name
      - type
      - status
      - updated
      - formula.days_since_edit
    limit: 50
